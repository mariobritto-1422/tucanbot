# =====================================================
# TUCANBOT - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =====================================================

# ─────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────────────
# URL de tu proyecto de Supabase (https://tu-proyecto.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (NO usar la anon key, necesitamos acceso completo)
# Encontrarla en: Project Settings > API > service_role key
# ⚠️ IMPORTANTE: Mantener esta key en secreto, solo usar en backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────
# EVOLUTION API
# ─────────────────────────────────────────────────────
# URL base de tu instancia de Evolution API (sin trailing slash)
EVOLUTION_API_URL=https://tu-evolution-api.com

# API Key de Evolution API
# Se usa en el header "apikey" para todas las peticiones
EVOLUTION_API_KEY=tu_api_key_de_evolution

# ─────────────────────────────────────────────────────
# WEBHOOK
# ─────────────────────────────────────────────────────
# Secreto para validar que los webhooks vienen de Evolution API
# Este mismo valor debe configurarse en Evolution API como header x-api-key
# Generar uno seguro: openssl rand -hex 32
WEBHOOK_SECRET=genera_un_secreto_aleatorio_largo_aqui

# ─────────────────────────────────────────────────────
# NOTAS IMPORTANTES
# ─────────────────────────────────────────────────────
# 1. Copiar este archivo a .env y completar con tus valores reales
# 2. Nunca commitear el archivo .env a git
# 3. En producción, usar variables de entorno del sistema/plataforma
# 4. Para generar WEBHOOK_SECRET: openssl rand -hex 32
# 5. El instance_key se identifica automáticamente desde el webhook
